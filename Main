"""Train and evaluate the MS TE-CDE experiment.

Expected input file
-------------------
A pickle containing a dictionary with the nine original DataFrames:
    age_df
    cumulative_visits_df
    disability_df
    disease_duration_df
    gender_df
    relapse_df              # cumulative relapse count
    t2_mri_lesion_df
    treatment_df            # integer treatment level 0..4
    visits_df

Example:
    python main_ms_te_cde.py --data-path ms_dataframes.pkl
"""

#it expects
dataframes = {
    "age_df": age_df,
    "cumulative_visits_df": cumulative_visits_df,
    "disability_df": disability_df,
    "disease_duration_df": disease_duration_df,
    "gender_df": gender_df,
    "relapse_df": relapse_df,
    "t2_mri_lesion_df": t2_mri_lesion_df,
    "treatment_df": treatment_df,
    "visits_df": visits_df,
}

with open("ms_dataframes.pkl", "wb") as f:
    pickle.dump(dataframes, f)

#
import numpy as np
import scipy
import torch
import torchdiffeq
import torchcde

print("NumPy:", np.__version__)
print("SciPy:", scipy.__version__)
print("PyTorch:", torch.__version__)
print("torchcde:", torchcde.__version__)

print("Imports successful.")

import sys
import numpy as np
import scipy

print(sys.executable)
print(np.__file__)
print(scipy.__file__)

from __future__ import annotations

import argparse
import logging
import pickle
from pathlib import Path

import numpy as np

from data_utils_ms import (
    N_TREATMENTS,
    build_train_val_test,
    describe_dataset,
)
from trainer_ms import Trainer

try:
    import wandb
except ImportError:  # W&B is optional.
    wandb = None

FORECAST_LENGTH = 20

def parse_args():
    parser = argparse.ArgumentParser()
    parser.add_argument("--data-path", type=str, default = "ms_dataframes.pkl")
    parser.add_argument("--output-dir", type=str, default="results_ms_te_cde")
    parser.add_argument("--random-state", type=int, default=42)

    parser.add_argument("--hidden-channels", type=int, default=64)
    parser.add_argument("--epochs", type=int, default=5)
    parser.add_argument("--patience", type=int, default=15)
    parser.add_argument("--batch-size", type=int, default=128)
    parser.add_argument("--learning-rate", type=float, default=1e-3)
    parser.add_argument("--weight-decay", type=float, default=1e-5)
    parser.add_argument("--dropout", type=float, default=0.1)
    parser.add_argument("--interpolation", choices=["linear", "cubic"], default="linear")

    # Start with zero to establish that forecasting works before adding treatment balancing.
    parser.add_argument("--lambda-treatment", type=float, default=0.0)
    parser.add_argument("--increment-loss-weight", type=float, default=0.25)
    parser.add_argument("--mc-samples", type=int, default=0)

    parser.add_argument("--use-wandb", action="store_true")
    parser.add_argument("--wandb-project", type=str, default="ms-te-cde")
    parser.add_argument("--wandb-name", type=str, default=None)
    return parser.parse_args()


def load_dataframes(path: str):
    with open(path, "rb") as handle:
        dataframes = pickle.load(handle)
    if not isinstance(dataframes, dict):
        raise TypeError("--data-path must contain a dictionary of pandas DataFrames.")
    return dataframes


def save_results(results, test_patient_ids, output_dir: Path):
    output_dir.mkdir(parents=True, exist_ok=True)

    np.savez_compressed(
        output_dir / "test_predictions.npz",
        
        patient_ids=test_patient_ids,
        
        predicted_cumulative_relapse=results["predicted_cumulative_relapse"],
            
        predicted_relapse_increment=results["predicted_relapse_increment"],
        
        true_cumulative_relapse=results["true_cumulative_relapse"],
            
        true_relapse_increment=results["true_relapse_increment"],
            
        future_active=results["future_active"],
            
        rmse_by_horizon=results["rmse_by_horizon"],
            
        mae_by_horizon=results["mae_by_horizon"],
        
        n_active_by_horizon=results["n_active_by_horizon"])

    metrics = {
        "overall_rmse": results["overall_rmse"],
        "overall_mae": results["overall_mae"],
        "rmse_by_horizon": results["rmse_by_horizon"].tolist(),
        "mae_by_horizon": results["mae_by_horizon"].tolist(),
        "n_active_by_horizon": results["n_active_by_horizon"].tolist(),
        }

    with open(output_dir / "metrics.pkl", "wb") as handle:
        pickle.dump(metrics, handle)


def main():
    args = parse_args()
    logging.basicConfig(
        level=logging.INFO,
        format="%(asctime)s | %(levelname)s | %(message)s",
    )

    output_dir = Path(args.output_dir)
    output_dir.mkdir(parents=True, exist_ok=True)

    logging.info("Loading raw MS DataFrames from %s", args.data_path)
    dataframes = load_dataframes(args.data_path)

    logging.info("Building Q1-Q20 history / Q21-Q40 forecast datasets")
    training_data, validation_data, test_data, preprocessing_params = build_train_val_test(
        dataframes,
        random_state=args.random_state,
    )
    
    with open(output_dir / "test_data.pkl", "wb") as handle:
        pickle.dump(test_data, handle)

    describe_dataset("TRAIN", training_data)
    describe_dataset("VALIDATION", validation_data)
    describe_dataset("TEST", test_data)

    with open(output_dir / "preprocessing_params.pkl", "wb") as handle:
        pickle.dump(preprocessing_params, handle)

    run = None
    if args.use_wandb:
        if wandb is None:
            raise ImportError("wandb is not installed. Install it or omit --use-wandb.")
        run = wandb.init(
            project=args.wandb_project,
            name=args.wandb_name,
            config=vars(args),
        )

    trainer = Trainer(
        run=run,
        hidden_channels=args.hidden_channels,
        n_treatments=N_TREATMENTS,
        learning_rate=args.learning_rate,
        weight_decay=args.weight_decay,
        lambda_treatment=args.lambda_treatment,
        increment_loss_weight=args.increment_loss_weight,
        dropout=args.dropout,
        interpolation=args.interpolation,
        checkpoint_path=str(output_dir / "best_model.pt"),
    )
    
    for name, data in [
    ("train", training_data),
    ("validation", validation_data),
    ("test", test_data),
    ]:
        print(f"\n{name}")

    for key, value in data.items():
        if isinstance(value, np.ndarray) and np.issubdtype(value.dtype, np.number):
            print(
                key,
                "shape =", value.shape,
                "NaN =", np.isnan(value).sum(),
                "Inf =", np.isinf(value).sum(),
            )

    trainer.fit(
        train_data=training_data,
        validation_data=validation_data,
        epochs=args.epochs,
        patience=args.patience,
        batch_size=args.batch_size,
    )

    logging.info("Evaluating Q21-Q40 factual forecasts")
    
    results = trainer.predict(
        test_data,
        batch_size=args.batch_size,
        mc_samples=args.mc_samples,)

    logging.info("Overall RMSE: %.4f", results["overall_rmse"])
    logging.info("Overall MAE: %.4f", results["overall_mae"])

    for horizon, (rmse, mae) in enumerate(
        zip(results["rmse_by_horizon"], results["mae_by_horizon"]), start=21
    ):
        logging.info("Q%d | RMSE %.4f | MAE %.4f", horizon, rmse, mae)
        
    # ============================================================
    # NAIVE BASELINE
    # Predict that cumulative relapse stays unchanged after Q20
    # ============================================================
    
    baseline = test_data["baseline_relapse"][:, None]
    
    naive_predictions = np.repeat(
        baseline,
        FORECAST_LENGTH,
        axis=1,
        )
    
    true = test_data["future_cumulative_relapse"]
    future_active = test_data["future_active"]
    
    observed = future_active == 1
    
    if not observed.any():
        raise RuntimeError(
            "No active future observations available in test set."
            )
        
        errors = naive_predictions - true
        
        naive_rmse = np.sqrt(
            np.mean(
                errors[observed] ** 2
                )
            )
        
        naive_mae = np.mean(
            np.abs(
                errors[observed]
                )
            )
    
    logging.info("Naive baseline overall RMSE: %.4f", naive_rmse)

    logging.info("Naive baseline overall MAE: %.4f", naive_mae,)
    
    # Per-quarter naive performance

    naive_rmse_by_horizon = np.full(
        FORECAST_LENGTH,
        np.nan,
        dtype=np.float32,
        )
    
    naive_mae_by_horizon = np.full(
        FORECAST_LENGTH,
        np.nan,
        dtype=np.float32,
        )
    
    naive_n_active_by_horizon = np.zeros(
        FORECAST_LENGTH,
        dtype=np.int64,
        )
    
    for t in range(FORECAST_LENGTH):
        
        active_t = future_active[:, t] == 1
        
        naive_n_active_by_horizon[t] = int(
            active_t.sum()
            )
        
        if not active_t.any():
            continue
        
        errors_t = (
            naive_predictions[active_t, t]
            - true[active_t, t]
            )
        
        naive_rmse_by_horizon[t] = np.sqrt(
            np.mean(errors_t ** 2)
            )
        
        naive_mae_by_horizon[t] = np.mean(
            np.abs(errors_t)
            )

    for quarter, (rmse, mae, n_active) in enumerate(
            zip(
                naive_rmse_by_horizon,
                naive_mae_by_horizon,
                naive_n_active_by_horizon,
                ),
            start=21,
            ):
        logging.info(
            "Naive Q%d | N active %d | RMSE %.4f | MAE %.4f",
            quarter,
            n_active,
            rmse,
            mae,
            )

    save_results(results, test_data["patient_ids"], output_dir)

    if run is not None:
        run.finish()


if __name__ == "__main__":
    main()
