def init_arg():
    parser = argparse.ArgumentParser()
    #parser.add_argument("--chemo_coeff", default=2, type=int)
    #parser.add_argument("--radio_coeff", default=2, type=int)
    parser.add_argument("--results_dir", default="results")
    parser.add_argument("--model_name", default="te_cde_trial")
    parser.add_argument("--load_dataset", default=True)
    parser.add_argument("--experiment", type=str, default="default")
    parser.add_argument("--data_path", type=str, default='C:/Users/ck624/my_AI_projects/TE-CDE/pickle_map_ms_TECDE.npy')
    parser.add_argument("--use_transformed", default=True)
    parser.add_argument("--multistep", default=True) #[--multistep [boolean whether to run the multistep function]]
    #multistep is saying you have multiple timpoints in the future you want to predict for
    parser.add_argument("--kappa", type=int, default=10)
    parser.add_argument("--lambda_val", type=float, default=1)
    parser.add_argument("--max_samples", type=int, default=1)
    parser.add_argument("--max_horizon", type=int, default=20)
    parser.add_argument("--save_raw_datapath", type=str, default=None)
    parser.add_argument("--save_transformed_datapath", type=str, default=None)
    return parser.parse_args()

args = init_arg()     #setting arguments

