"""MS-specific TE-CDE model and trainer.

The model encodes Q1-Q20 with a Neural CDE, then evolves that latent state
through a treatment-conditioned future CDE over Q20-Q40. It predicts
non-negative relapse increments for Q21-Q40 and converts them to cumulative
relapse counts by cumulative summation from the observed Q20 count.
"""

from __future__ import annotations

import copy
import logging
from pathlib import Path
from typing import Dict, Optional

import numpy as np
import torch
import torch.nn as nn
import torch.nn.functional as F
import torchcde
from torch.utils.data import DataLoader, TensorDataset

class GradientReversalFunction(torch.autograd.Function):
    """
    Forward pass: identity.

    Backward pass:
        dL/dx -> -alpha * dL/dx

    This lets the treatment classifier minimize treatment prediction loss
    while forcing the encoder to maximize that same loss.
    """

    @staticmethod
    def forward(ctx, x, alpha):
        ctx.alpha = alpha
        return x.view_as(x)

    @staticmethod
    def backward(ctx, grad_output):
        return -ctx.alpha * grad_output, None


class GradientReversal(nn.Module):
    def __init__(self, alpha: float = 1.0):
        super().__init__()
        self.alpha = alpha

    def forward(self, x, alpha=None):
        if alpha is None:
            alpha = self.alpha

        return GradientReversalFunction.apply(x, alpha)
    
class CDEFunc(nn.Module):
    def __init__(self, input_channels: int, hidden_channels: int):
        super().__init__()
        self.input_channels = input_channels
        self.hidden_channels = hidden_channels
        self.net = nn.Sequential(
            nn.Linear(hidden_channels, 128),
            nn.ReLU(),
            nn.Linear(128, hidden_channels * input_channels),
        )

    def forward(self, t, z):
        out = self.net(z)
        return out.view(z.size(0), self.hidden_channels, self.input_channels)


class MSTECDE(nn.Module):
    def __init__(
        self,
        history_channels: int,
        future_control_channels: int,
        hidden_channels: int = 64,
        n_treatments: int = 5,
        dropout: float = 0.1,
        interpolation: str = "linear",
    ):
        super().__init__()
        self.hidden_channels = hidden_channels
        self.interpolation = interpolation

        self.history_embed = nn.Linear(history_channels, hidden_channels)
        self.encoder_func = CDEFunc(history_channels, hidden_channels)
        self.decoder_func = CDEFunc(future_control_channels, hidden_channels)

        self.relapse_increment_head = nn.Linear(hidden_channels,1)

        # Adversarial treatment branch
        self.gradient_reversal = GradientReversal(alpha=1.0)

        self.treatment_head = nn.Sequential(nn.Linear(hidden_channels, hidden_channels), nn.ReLU(), nn.Dropout(dropout),nn.Linear(hidden_channels, n_treatments))

        self.dropout = nn.Dropout(dropout)

    def _make_path(self, coeffs):
        if self.interpolation == "linear":
            return torchcde.LinearInterpolation(coeffs)
        if self.interpolation == "cubic":
            return torchcde.NaturalCubicSpline(coeffs)
        raise ValueError("interpolation must be 'linear' or 'cubic'.")

    def forward(
            self,
            history_coeffs,
            future_coeffs,
            baseline_relapse,
            adversarial_alpha: float = 0.0,
            mcd: bool = False,
            ):

        history_path = self._make_path(history_coeffs)
        history_t = history_path.grid_points
        x0 = history_path.evaluate(history_t[0])

        # Do NOT wrap differentiable tensors in torch.tensor(...): that would detach them.
        z0 = self.history_embed(x0)

        z_history = torchcde.cdeint(
            X=history_path,
            z0=z0,
            func=self.encoder_func,
            t=history_t,
            backend="torchdiffeq",
            method="dopri5",
            options={"jump_t": history_path.grid_points},
        )
        z20 = z_history[:, -1, :]

        if mcd:
            z20 = F.dropout(z20, p=self.dropout.p, training=True)

    # Gradient reversal is identity during the forward pass,
    # but reverses the gradient flowing back into the encoder.
        z20_adv = self.gradient_reversal(
            z20,
            alpha=adversarial_alpha,
            )
        
        treatment_logits = self.treatment_head(
            z20_adv
            )

        future_path = self._make_path(future_coeffs)
        future_t = future_path.grid_points
        z_future = torchcde.cdeint(
            X=future_path,
            z0=z20,
            func=self.decoder_func,
            t=future_t,
            backend="torchdiffeq",
            method="dopri5",
            options={"jump_t": future_path.grid_points},
        )

        # Point zero is Q20; points 1..20 correspond to Q21..Q40.
        z_future = z_future[:, 1:, :]
        if mcd:
            z_future = F.dropout(z_future, p=self.dropout.p, training=True)

        raw_increment = self.relapse_increment_head(z_future).squeeze(-1)
        predicted_increment = F.softplus(raw_increment)
        predicted_cumulative = baseline_relapse[:, None] + torch.cumsum(
            predicted_increment, dim=1
        )

        return {
            "cumulative_relapse": predicted_cumulative,
            "relapse_increment": predicted_increment,
            "treatment_logits": treatment_logits,
            "z20": z20,
            "future_states": z_future,
        }


def _make_coefficients(control: torch.Tensor, interpolation: str) -> torch.Tensor:
    if interpolation == "linear":
        return torchcde.linear_interpolation_coeffs(control)
    if interpolation == "cubic":
        return torchcde.natural_cubic_coeffs(control)
    raise ValueError("interpolation must be 'linear' or 'cubic'.")


def prepare_dataloader(
    data: Dict[str, np.ndarray],
    batch_size: int,
    shuffle: bool,
    interpolation: str = "linear",
) -> DataLoader:

    history_x = torch.from_numpy(
        data["history_covariates"]
    ).float()

    history_a = torch.from_numpy(
        data["history_treatments"]
    ).float()

    history_time = torch.from_numpy(
        data["history_time"]
    ).float()

    history_control = torch.cat(
        [history_x, history_a, history_time],
        dim=-1,
    )

    history_coeffs = _make_coefficients(
        history_control,
        interpolation,
    )

    future_a = torch.from_numpy(
        data["future_treatments"]
    ).float()

    future_time = torch.from_numpy(
        data["future_time"]
    ).float()

    future_control = torch.cat(
        [future_a, future_time],
        dim=-1,
    )

    future_coeffs = _make_coefficients(
        future_control,
        interpolation,
    )

    baseline = torch.from_numpy(
        data["baseline_relapse"]
    ).float()

    future_cumulative = torch.from_numpy(
        data["future_cumulative_relapse"]
    ).float()

    future_increment = torch.from_numpy(
        data["future_relapse_increments"]
    ).float()

    # NEW
    future_active = torch.from_numpy(
        data["future_active"]
    ).float()

    dataset = TensorDataset(
        history_coeffs,
        future_coeffs,
        baseline,
        future_cumulative,
        future_increment,
        future_a,
        future_active,
    )

    return DataLoader(
        dataset,
        batch_size=batch_size,
        shuffle=shuffle,
    )

def masked_smooth_l1_loss(
    prediction,
    target,
    mask,
):
    """
    Compute Smooth L1 loss only for active/observed quarters.
    """

    element_loss = F.smooth_l1_loss(
        prediction,
        target,
        reduction="none",
    )

    mask = mask.float()

    return (
        element_loss * mask
    ).sum() / mask.sum().clamp_min(1.0)


class Trainer:
    def __init__(
        self,
        run=None,
        hidden_channels: int = 64,
        n_treatments: int = 5,
        learning_rate: float = 1e-3,
        weight_decay: float = 1e-5,
        lambda_treatment: float = 0.0,
        increment_loss_weight: float = 0.25,
        dropout: float = 0.1,
        interpolation: str = "linear",
        gradient_clip: float = 1.0,
        checkpoint_path: str = "./tmp_models/ms_te_cde_best.pt",
    ):
        self.run = run
        self.hidden_channels = hidden_channels
        self.n_treatments = n_treatments
        self.learning_rate = learning_rate
        self.weight_decay = weight_decay
        self.lambda_treatment = lambda_treatment
        self.increment_loss_weight = increment_loss_weight
        self.dropout = dropout
        self.interpolation = interpolation
        self.gradient_clip = gradient_clip
        self.checkpoint_path = Path(checkpoint_path)

        self.device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
        self.model: Optional[MSTECDE] = None

    @staticmethod
    def _move_batch(batch, device):
        return [x.to(device=device, dtype=torch.float32) for x in batch]

    def _losses(
            self,
            predictions,
            true_cumulative,
            true_increment,
            future_treatment,
            future_active,
            ):  

        # ----------------------------------------------
        # Outcome losses:
            # only count quarters still under follow-up
            # ----------------------------------------------

        cumulative_loss = masked_smooth_l1_loss(
            predictions["cumulative_relapse"],
            true_cumulative,
            future_active,
            )

        increment_loss = masked_smooth_l1_loss(
            predictions["relapse_increment"],
            true_increment,
            future_active,
            )

        outcome_loss = (
            cumulative_loss
            + self.increment_loss_weight * increment_loss
            )

        # ----------------------------------------------
        # Adversarial Q21 treatment prediction
        # ----------------------------------------------

        # future_treatment[:, 0] = Q20 boundary
        # future_treatment[:, 1] = Q21 treatment

        q21_treatment = torch.argmax(
            future_treatment[:, 1, :],
            dim=1,
            )

        treatment_loss_each = F.cross_entropy(
            predictions["treatment_logits"],
            q21_treatment,
            reduction="none",
            )

        # future_active[:, 0] corresponds to Q21
        q21_active = future_active[:, 0]
        
        treatment_loss = (
            treatment_loss_each * q21_active
            ).sum() / q21_active.sum().clamp_min(1.0)
        
        # GRL applies adversarial coefficient
        total_loss = (
            outcome_loss
            + treatment_loss
            )

        return (
            total_loss,
            outcome_loss,
            cumulative_loss,
            increment_loss,
            treatment_loss,
            )

    def _run_epoch(
            self,
            dataloader,
            optimizer=None,
            adversarial_alpha: float = 0.0,
            ):
        training = optimizer is not None
        self.model.train(training)

        metrics = {
            "total": [],
            "outcome": [],
            "cumulative": [],
            "increment": [],
            "treatment": [],
        }

        context = torch.enable_grad() if training else torch.no_grad()
        with context:
            for batch in dataloader:
                (
                    history_coeffs,
                    future_coeffs,
                    baseline,
                    true_cumulative,
                    true_increment,
                    future_treatment,
                    future_active,
                    ) = self._move_batch(
                        batch,
                        self.device,
                        )

                if training:
                    optimizer.zero_grad(set_to_none=True)

                predictions = self.model(
                    history_coeffs=history_coeffs,
                    future_coeffs=future_coeffs,
                    baseline_relapse=baseline,
                    adversarial_alpha=adversarial_alpha,
                    )

                losses = self._losses(
                    predictions,
                    true_cumulative,
                    true_increment,
                    future_treatment,
                    future_active,
                )
                total, outcome, cumulative, increment, treatment = losses

                if training:
                    total.backward()
                    torch.nn.utils.clip_grad_norm_(
                        self.model.parameters(), self.gradient_clip
                    )
                    optimizer.step()

                for name, value in zip(metrics, losses):
                    metrics[name].append(value.item())

        return {name: float(np.mean(values)) for name, values in metrics.items()}

    def fit(
        self,
        train_data,
        validation_data,
        epochs: int = 100,
        patience: int = 15,
        batch_size: int = 128,
    ):
        train_loader = prepare_dataloader(
            train_data, batch_size=batch_size, shuffle=True, interpolation=self.interpolation
        )
        val_loader = prepare_dataloader(
            validation_data, batch_size=batch_size, shuffle=False, interpolation=self.interpolation
        )

        history_channels = (
            train_data["history_covariates"].shape[-1]
            + train_data["history_treatments"].shape[-1]
            + train_data["history_time"].shape[-1]
        )
        future_control_channels = (
            train_data["future_treatments"].shape[-1]
            + train_data["future_time"].shape[-1]
        )

        self.model = MSTECDE(
            history_channels=history_channels,
            future_control_channels=future_control_channels,
            hidden_channels=self.hidden_channels,
            n_treatments=self.n_treatments,
            dropout=self.dropout,
            interpolation=self.interpolation,
        ).to(self.device)

        optimizer = torch.optim.AdamW(
            self.model.parameters(),
            lr=self.learning_rate,
            weight_decay=self.weight_decay,
        )

        self.checkpoint_path.parent.mkdir(parents=True, exist_ok=True)
        best_val = np.inf
        best_state = None
        epochs_without_improvement = 0

        logging.info("Training on %s", self.device)
        logging.info(
            "history_channels=%d, future_control_channels=%d",
            history_channels,
            future_control_channels,
        )

        for epoch in range(1, epochs + 1):

            progress = (
                (epoch - 1)
                / max(epochs - 1, 1)
                )
            adv_alpha = 0.2
            
            train_metrics = self._run_epoch(
                train_loader,
                optimizer=optimizer,
                adversarial_alpha=adv_alpha,
                )
            
            val_metrics = self._run_epoch(
                val_loader,
                optimizer=None,
                adversarial_alpha=0.0,
                )
            
            logging.info(
                (
                    "Epoch %03d | "
                    "adv alpha %.4f | "
                    "train outcome %.5f | "
                    "train treatment %.5f | "
                    "val outcome %.5f | "
                    "val cumulative %.5f | "
                    "val treatment %.5f"
                    ),
                epoch,
                adv_alpha,
                train_metrics["outcome"],
                train_metrics["treatment"],
                val_metrics["outcome"],
                val_metrics["cumulative"],
                val_metrics["treatment"],
                )

        if best_state is None:
            raise RuntimeError("Training ended without producing a checkpoint.")
        self.model.load_state_dict(best_state)
        return self.model

    def predict(self, test_data, batch_size: int = 256, mc_samples: int = 0):
        if self.model is None:
            raise RuntimeError("Call fit() or load_model() before predict().")

        loader = prepare_dataloader(
            test_data,
            batch_size=batch_size,
            shuffle=False,
            interpolation=self.interpolation,
            )
        all_active = []
        all_cumulative = []
        all_increment = []
        all_true_cumulative = []
        all_true_increment = []
        all_treatment_logits = []
        all_baseline = []  # NEW

        self.model.eval()
        
        with torch.no_grad():
            for batch in loader:
                (
                    history_coeffs,
                    future_coeffs,
                    baseline,
                    true_cumulative,
                    true_increment,
                    future_treatment,
                    future_active,
                    ) = self._move_batch(batch, self.device)
                
                if mc_samples and mc_samples > 1:
                    samples = []
                    increment_samples = []
                    
                    for _ in range(mc_samples):
                        pred = self.model(
                            history_coeffs=history_coeffs,
                            future_coeffs=future_coeffs,
                            baseline_relapse=baseline,
                            adversarial_alpha=0.0,
                            mcd=False,
                            )
                        
                        samples.append(
                            pred["cumulative_relapse"]
                            )
                        
                        increment_samples.append(
                            pred["relapse_increment"]
                            )
                        
                        cumulative_pred = (
                            torch.stack(samples)
                            .mean(dim=0)
                            )

                    increment_pred = (
                        torch.stack(increment_samples)
                        .mean(dim=0)
                        )

                    treatment_logits = pred[
                        "treatment_logits"
                        ]

                else:
                    pred = self.model(
                        history_coeffs=history_coeffs,
                        future_coeffs=future_coeffs,
                        baseline_relapse=baseline,
                        adversarial_alpha=0.0,
                        mcd=False,
                        )

                    cumulative_pred = pred[
                        "cumulative_relapse"
                        ]
                    
                    increment_pred = pred[
                        "relapse_increment"
                        ]
                    
                    treatment_logits = pred[
                        "treatment_logits"
                        ]

                # Store batch outputs
                all_cumulative.append(
                    cumulative_pred.cpu()
                    )
                
                all_increment.append(
                    increment_pred.cpu()
                    )
                
                all_true_cumulative.append(
                    true_cumulative.cpu()
                    )
                
                all_true_increment.append(
                    true_increment.cpu()
                    )
                
                all_treatment_logits.append(
                    treatment_logits.cpu()
                    )
                
                all_baseline.append(
                    baseline.cpu()
                    )
                all_active.append(
                    future_active.cpu()
                    )


    # ------------------------------------------------------
    # Combine all batches
    # ------------------------------------------------------

        pred_cumulative = (
            torch.cat(all_cumulative)
            .numpy()
            )
        
        pred_increment = (
            torch.cat(all_increment)
            .numpy()
            )
        
        true_cumulative = (
            torch.cat(all_true_cumulative)
            .numpy()
            )
        
        true_increment = (
            torch.cat(all_true_increment)
            .numpy()
            )
        
        treatment_logits = (
            torch.cat(all_treatment_logits)
            .numpy()
            )
        future_active = (
            torch.cat(all_active)
            .numpy()
            )
        
        print("predictions:", pred_cumulative.shape)
        print("truth:", true_cumulative.shape)
        
        
        # ------------------------------------------------------
        # Metrics
        # ------------------------------------------------------
        
        # ------------------------------------------------------
        # Metrics using only active/observed quarters
        # ------------------------------------------------------
        
        n_horizons = pred_cumulative.shape[1]

        rmse_by_horizon = np.full(
            n_horizons,
            np.nan,
            dtype=np.float32,
            )
        
        mae_by_horizon = np.full(
            n_horizons,
            np.nan,
            dtype=np.float32,
            )
        
        n_active_by_horizon = np.zeros(
            n_horizons,
            dtype=np.int64,
            )
    
        for t in range(n_horizons):
            
            active_t = future_active[:, t] == 1
            
            n_active_by_horizon[t] = int(active_t.sum())
                
            if not active_t.any():
                continue

        errors_t = (
            pred_cumulative[active_t, t]
            - true_cumulative[active_t, t]
            )
        
        rmse_by_horizon[t] = np.sqrt(
            np.mean(errors_t ** 2)
                )
        
        mae_by_horizon[t] = np.mean(
            np.abs(errors_t)
            )

    # Overall metrics across all observed patient-quarters
    
        observed = future_active == 1
        
        if not observed.any():
            raise RuntimeError(
                "No active future observations available in test set."
                )
            
            errors = (
                pred_cumulative
                - true_cumulative
                )
            
            overall_rmse = float(
                np.sqrt(
                    np.mean(
                        errors[observed] ** 2
                        )
                    )
                )
        
            overall_mae = float(
                np.mean(
                    np.abs(
                        errors[observed]
                        )
                    )
                )
        
        # ------------------------------------------------------
        # Return results
        # ------------------------------------------------------
        
        results = {
            "predicted_cumulative_relapse": pred_cumulative,
            "predicted_relapse_increment": pred_increment,
            "true_cumulative_relapse": true_cumulative,
            "true_relapse_increment": true_increment,
            "future_active": future_active,
            "treatment_logits_q21": treatment_logits,
            "rmse_by_horizon": rmse_by_horizon,
            "mae_by_horizon": mae_by_horizon,
            "overall_rmse": overall_rmse,
            "overall_mae": overall_mae,
            }
        
        if self.run is not None:
            self.run.log(
                {
                    "test/overall_rmse": overall_rmse,
                    "test/overall_mae": overall_mae,
                    **{
                        f"test/rmse_Q{21+i}": v
                        for i, v in enumerate(
                                rmse_by_horizon
                                )
                        },
                    }
                )
            
        return results

    def predict_counterfactual(
        self,
        history_data,
        future_treatments: np.ndarray,
        future_time: Optional[np.ndarray] = None,
        batch_size: int = 256,
    ):
        """Predict under a user-supplied Q20-Q40 treatment trajectory.

        future_treatments must have shape (N, 21, 5): Q20 boundary + Q21-Q40.
        This performs model-based counterfactual prediction; causal interpretation still
        depends on the usual observational-data assumptions.
        """
        scenario = dict(history_data)
        scenario["future_treatments"] = future_treatments.astype(np.float32)
        if future_time is not None:
            scenario["future_time"] = future_time.astype(np.float32)
        return self.predict(scenario, batch_size=batch_size)
    
    
