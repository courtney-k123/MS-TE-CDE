    def fit_multistep( #A training loop (fit_multistep) that uses this NeuralCDE model
        self,
        train_data,
        validation_data,
        epochs,
        patience,
        batch_size,
        max_horizon,
    ):
        logging.info("Getting training data for multistep")

        if torch.cuda.is_available():
            device_type = "cuda"
        else:
            device_type = "cpu"

        device = torch.device(device_type)

        self.device = device

        logging.info(f"Predicting using device: {device_type}")
        early_stopping = EarlyStopping(patience=patience, delta=0.0001)#Initializes early stopping with the patience value (i.e., how many epochs to wait for improvement).
        #check at this point what my model is
        #self.model = model
        print("Model:", self.model)
        
        # create dataloaders
        train_dataloader, data_shape = self.prepare_dataloader_multistep(
            data=train_data,
            batch_size=int(batch_size),
            max_horizon=max_horizon,
        )#Converts train_data into a DataLoader using the sliding-window method in process_seq_data
        val_dataloader, _ = self.prepare_dataloader_multistep(
            data=validation_data,
            batch_size=int(batch_size),
            max_horizon=max_horizon,
        )#Does the same for validation data.

        ######################
        logging.info("Instantiating Neural CDE multistep")

        model_multistep = NeuralCDE(
            input_channels_x=data_shape[2],
            hidden_channels_x=self.hidden_channels_x,
            output_channels=20,
        )#creates a fresh neural CDE model 
        #input is the concatenated features (covariates + treatment)
        #Output: 20-dimensional predictions (matches your output horizon × dim (1)).

        model_multistep = model_multistep.to(self.device) #Moves model to GPU/CPU.

        #using stochastic gradient descent 
        #Stochastic Gradient Descent (SGD) is a machine learning optimization algorithm that updates model parameters using gradients calculated from a randomly selected subset (or a single data point) of the training dataset, making it efficient for large datasets and online learning. 
        optimizer_multistep = torch.optim.SGD(
            model_multistep.parameters(),
            lr=0.0001,
            momentum=0.9,
        ) #setting up the optimiser, using sotachastic gradient descent witha small learning rate and good momentum to smooth updates 
        #Learning rate, or step size, is represented by the Greek letter η, and determines the size of the changes the model is permitted to make. 
        #Learning rate helps ensure that a model learns enough from training to make meaningful adjustments to its parameters while also not overcorrecting. Imagine descending a hill. To reach the bottom safely, one must travel fast enough to make meaningful progress, but not too fast that one loses control and stumbles. 
        
        
        # optimizer =  = torch.optim.Adam(model.parameters())  # , lr=0.01
        # optimizer = torch.optim.Adam(model.parameters(), lr=0.0001)  # , lr=0.01

        self.run.watch(model_multistep, log="all") #Hooks the model into wandb for full logging/monitoring of gradients, weights, etc.

        logging.info("Training CDE")

        epochs = 10
        lambda_vals = np.linspace(0.0, 1.0, num=epochs) #lambda_vals: used to gradually increase the weight of a certain loss component (likely treatment vs. outcome loss — see below).

        for epoch in tqdm(range(epochs)):

            lambda_val = lambda_vals[epoch] #Progressively scales lambda_val from 0 to 1.
            logging.info(f"Training epoch: {epoch} & lambda: {lambda_val}")
            # put into train mode

            (
                model_multistep,
                train_losses_total,
                train_losses_y,
                train_losses_a,
            ) = self._train(
                train_dataloader=train_dataloader,
                model=model_multistep,
                optimizer=optimizer_multistep,
                lambda_val=lambda_val,
            ) #Runs a training epoch, returning:
                    #train_losses_total: overall loss
                    #train_losses_y: loss on predicted outcomes
                    #train_losses_a: loss on predicted treatments (if applicable)

            # zero grad check out + early stopping
            logging.info(f"Validation epoch: {epoch}")
            
            model_multistep, val_losses_total, val_losses_y, val_losses_a = self._test(
                test_dataloader=val_dataloader,
                model=model_multistep,
                lambda_val=lambda_val,
            ) #Runs a validation pass.

            tqdm.write(
                f"Epoch: {epoch}   Training loss: {np.average(train_losses_total)} ; Train Treatment loss: {np.average(train_losses_a)} ; Train Outcome loss: {np.average(train_losses_y)}, Val loss: {np.average(val_losses_total)} ;Val Treatment loss: {np.average(val_losses_a)} ; Val Outcome loss: {np.average(val_losses_y)}",
            )#Nicely formatted epoch summary printed to console/log.

            #Sanity Check + Logging - Fails fast if loss explodes or becomes NaN.
            if int(np.average(train_losses_y)) > 100000 or np.average(
                train_losses_y,
            ) == float("nan"):
                import sys

                raise ValueError("Exiting multistep run...")
                
            #Logs epoch stats to Weights & Biases (wandb).
            self.run.log(
                {
                    "Epoch": epoch,
                    "Training loss": np.average(train_losses_total),
                    "Train Treatment loss": np.average(train_losses_a),
                    "Train Outcome loss": np.average(train_losses_y),
                    "Val loss": np.average(val_losses_total),
                    "Val Treatment loss": np.average(val_losses_a),
                    "Val Outcome loss": np.average(val_losses_y),
                },
            )

            # Log model checkpoint to wandb
            torch.save(
                model_multistep.state_dict(),
                f"./tmp_models/model_multi_epoch_{epoch}.h5",
            )
            self.run.save(f"./tmp_models/model_multi_epoch_{epoch}.h5")

            # early_stopping needs the validation loss to check if it has decresed,
            # and if it has, it will make a checkpoint of the current model
            early_stopping(np.average(val_losses_y), model_multistep)

            if early_stopping.early_stop:
                print("Early stopping phase initiated...")
                break

        # load best model
        model_multistep.load_state_dict(torch.load("checkpoint.pt")) #saving the best model

        # Log model checkpoint to wandb
        torch.save(model_multistep.state_dict(), "./tmp_models/model_multi_final.h5")
        self.run.save("./tmp_models/model_multi_final.h5")

        self.multistep_model = model_multistep #store the trainer model for later use (with counterfactual testing)

    def multistep_predict(self, test_data, max_horizon): #A prediction function (multistep_predict) to forecast outcomes and treatment effects

        device = torch.device("cuda" if torch.cuda.is_available() else "cpu") #Set device (GPU if available).

        logging.info(f"Predicting with: {device}") #log it 

        treatment_loss = nn.CrossEntropyLoss()  # Define cross-entropy loss for evaluating treatment prediction.

        #redundant because done above
        if torch.cuda.is_available():
            device_type = "cuda"
        else:
            device_type = "cpu"

        device = torch.device(device_type)
        #########################
        #Convert raw test data to tensors:
        test_X, test_A, test_Time, test_y, test_treat, _, _ = data_to_torch_tensor(
            test_data,
            sample_prop=self.sample_proportion,
        )
        
        #Combine features and treatments for the encoder input (Neural CDE expects all features together).
        encode_concat = torch.cat((test_X, test_A), 2) # 

        # to make it continuous we interpolate (linear - keep causal interpretation)
        encode_coeffs = torchcde.linear_interpolation_coeffs(encode_concat)
        encode_coeffs = torch.tensor(encode_coeffs, dtype=torch.float, device=device)

        pred_y_test_sample, pred_a_test_sample, pred_a_test, z_hat_sample = self.model(
            encode_coeffs,
            device,
        )#initial prediction - encoding the latent states
        #foward pass of the model 
        #z_hat_sample: latent states after initial encoding.

        logging.info("Processing counterfactual data...")
        
        #Generate Counterfactual Sequences
        processed_data_multi = process_counterfactual_seq_test_data(
            data_map=test_data,
            states=z_hat_sample.cpu().detach().numpy(),#this is where the model is predicting states
            projection_horizon=max_horizon,
        )#Uses model-inferred states (z_hat_sample) to generate counterfactual futures for a given projection horizon.

        test_X, test_A, test_Time, test_y, test_treat = data_to_torch_tensor_multistep(
            processed_data_multi,
            sample_prop=self.sample_proportion,
            max_horizon=max_horizon,
        )#Converts the counterfactual sequences into tensors

        data_concat = torch.cat((test_X, test_A), 2)#Combines features and treatments again.
        data_shape = list(data_concat.shape)

        # to make it continuous we interpolate (linear - keep causal interpretation)-Interpolates the counterfactual input for CDE prediction.
        test_coeffs = torchcde.linear_interpolation_coeffs(data_concat)
        test_coeffs = torch.tensor(test_coeffs, dtype=torch.float, device=device)

        #Set up labels for evaluation
        outcomes_test = torch.tensor(test_y[:, :, 0], dtype=torch.float, device=device)#outcomes_test: the true future outcomes
        active_entries_test = torch.tensor(test_y[:, :, 1], dtype=torch.float, device=device,)#active_entries_test: missingness mask
        current_treatment_test = torch.tensor(test_treat[:, -1, :], dtype=torch.float, device=device,)#current_treatment_test: the most recent treatment given

        #Uses an autoregressive loop to forecast max_horizon steps.
        pred_y_test, pred_a_test, pred_a = self.pred_auto(
            test_coeffs,
            device=device,
            max_horizon=max_horizon,
        )#Each call to self.multistep_model(...) predicts one step forward.(?)

        #Computes normalized MSE for the final step of horizon.
        loss_y_test = compute_norm_mse_loss(
            outcomes_test[:, max_horizon - 1],
            pred_y_test[:, max_horizon - 1],
            active_entries_test[:, max_horizon - 1],
        )#This is the main loss used to measure outcome forecasting accuracy.

        #RMSEs for All Horizon Steps
        rmses = []

        rmses.append(
            torch.sqrt(
                compute_norm_mse_loss(outcomes_test, pred_y_test, active_entries_test),
            ).item(),
        )
        
        #Stepwise RMSEs (1-step ahead, 2-step ahead, etc.)
        for i in range(max_horizon):
            rmses.append(
                torch.sqrt(
                    compute_norm_mse_loss(
                        outcomes_test[:, i],
                        pred_y_test[:, i],
                        active_entries_test[:, i],
                    ),
                ).item(),
            )

        #Treatment Accuracy
        acc_scores = []
        for i in range(max_horizon):
            true = torch.tensor(
                processed_data_multi["current_treatments"][:, i, :],
                dtype=torch.float,
                device=device,
            )
            acc_scores.append(
                torchmetrics.functional.accuracy(
                    F.softmax(pred_a[i], dim=1),
                    torch.argmax(true, dim=1),
                ),
            )

        #Log to wandb
        self.run.log(
            {
                "RMSE MULTISTEP Test Outcome loss": np.sqrt(loss_y_test.item()),
            },
        )

        # RMSEs at other interval
        for i in range(len(rmses) - 1):
            self.run.log({f"RMSE @ {i+1} ": rmses[::-1][i]})

        for idx, acc in enumerate(acc_scores):
            self.run.log(
                {
                    f"MULTISTEP ACC @ {idx+1}": acc.item(),
                },
            )

