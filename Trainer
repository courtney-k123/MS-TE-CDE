    def pred_auto(self, test_coeffs, device, strategy, threshold=0.5):
    
    #Autoregressive rollout for counterfactual simulation.
    
        projection_horizon = 20
        preds = []
        treatments = []

    # Step 1: Encode past into latent z using NeuralCDE
        _, _, _, z = self.multistep_model(test_coeffs, device)  # z is [batch, hidden_dim]

    # Step 2: Initialize treatment based on strategy
        if strategy == "1→2→3":
            treatment = torch.ones(z.size(0), dtype=torch.long, device=z.device)
        elif strategy == "2→3":
            treatment = torch.full((z.size(0),), 2, dtype=torch.long, device=z.device)
        elif strategy == "just3":
            treatment = torch.full((z.size(0),), 3, dtype=torch.long, device=z.device)
        else:
            raise ValueError("Invalid strategy")

        for step in range(projection_horizon):
      # Step 3: Predict relapse (binary classification)
            pred_relapse, z_next = self.step_forward(z, treatment)
            relapse_prob = torch.sigmoid(pred_relapse).squeeze()

      # Step 4: Store
            preds.append(relapse_prob.detach().cpu())
            treatments.append(treatment.detach().cpu())

      # Step 5: Escalate treatment if relapse
            if strategy in ["1→2→3", "2→3"]:
                should_escalate = (relapse_prob >= threshold) & (treatment < 3)
                treatment = torch.where(should_escalate, treatment + 1, treatment)

    # Step 6: Move latent state forward
            z = z_next

    # Step 7: Stack across time
            preds = torch.stack(preds, dim=1)
            treatments = torch.stack(treatments, dim=1)

        return preds, treatments

#and to help evaluate the model using actual treatments 
    def predict_given_actual(self, test_coeffs, actual_treatments, device):
        projection_horizon = actual_treatments.size(1)
        preds = []

        _, _, _, z = self.multistep_model(test_coeffs, device)

        for t in range(projection_horizon):
            treatment = actual_treatments[:, t]
            pred_relapse, z = self.step_forward(z, treatment)
            relapse_prob = torch.sigmoid(pred_relapse).squeeze()
            preds.append(relapse_prob.detach().cpu())

        preds = torch.stack(preds, dim=1)
        return preds

    
