    def step_forward(self, z, treatment):
    
    #Predict next outcome and update latent state based on current treatment and latent state.
    #treatment: [batch] of ints (1, 2, 3)
    
        # Convert treatment to one-hot (assuming 3 treatments)
        treatment_onehot = F.one_hot(treatment - 1, num_classes=3).float()
        
        # Concatenate with latent state
        input_step = torch.cat([z, treatment_onehot], dim=-1)

        # Transition model: predict relapse + next state
        relapse_pred = self.relapse_head(input_step)  # shape: [batch, 1]
        z_next = self.latent_update(input_step)       # shape: [batch, latent_dim]

        return relapse_pred, z_next
