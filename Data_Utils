"""Utilities for the MS TE-CDE experiment.

Experiment definition
---------------------
Q1-Q20  : observed history used by the CDE encoder
Q21-Q40 : future period to predict
Q41     : deliberately unused in this experiment

The expected input is a dictionary of pandas DataFrames with keys:
    age_df, cumulative_visits_df, disability_df, disease_duration_df,
    gender_df, relapse_df, t2_mri_lesion_df, treatment_df, visits_df

Each DataFrame must contain PATIENT_ID and Quarter_1 ... Quarter_41.
relapse_df is expected to contain CUMULATIVE relapse counts.
"""

from __future__ import annotations

from dataclasses import dataclass
from typing import Dict, Iterable, Mapping, Tuple

import numpy as np
import pandas as pd

ID_COL = "PATIENT_ID"
QUARTER_COLS = [f"Quarter_{i}" for i in range(1, 41)]
HISTORY_LENGTH = 20
FORECAST_LENGTH = 20
N_TREATMENTS = 5

REQUIRED_DF_KEYS = (
    "age_df",
    "cumulative_visits_df",
    "disability_df",
    "disease_duration_df",
    "gender_df",
    "relapse_df",
    "t2_mri_lesion_df",
    "treatment_df",
    "visits_df",
    "active_entries_df",
)


@dataclass
class PreprocessingParams:
    """Training-set-only preprocessing parameters."""

    edss_fill_value: float
    mri_fill_value: float
    feature_means: np.ndarray
    feature_stds: np.ndarray
    continuous_feature_indices: Tuple[int, ...]


FEATURE_NAMES = (
    "edss",
    "cumulative_relapse",
    "t2_mri_lesions",
    "age",
    "disease_duration",
    "gender",
    "cumulative_visits",
    "edss_observed",
    "mri_observed",
    "active_entry",
)

# Everything except gender and the two missingness indicators is standardised.
CONTINUOUS_FEATURE_INDICES = (0, 1, 2, 3, 4, 6)


def _quarter_values(df: pd.DataFrame, ids: Iterable, dtype=np.float32) -> np.ndarray:
    """Return rows in exactly the requested patient order."""
    indexed = df.set_index(ID_COL)
    return indexed.loc[list(ids), QUARTER_COLS].to_numpy(dtype=dtype)


def validate_dataframes(dataframes: Mapping[str, pd.DataFrame]) -> None:
    """Fail early if the longitudinal tables are not compatible."""
    missing = [key for key in REQUIRED_DF_KEYS if key not in dataframes]
    if missing:
        raise KeyError(f"Missing DataFrames: {missing}")

    reference = dataframes["age_df"]
    expected_ids = set(reference[ID_COL])

    if reference[ID_COL].duplicated().any():
        raise ValueError("age_df contains duplicate PATIENT_ID values.")

    for name in REQUIRED_DF_KEYS:
        df = dataframes[name]
        required_cols = [ID_COL, *QUARTER_COLS]
        missing_cols = [col for col in required_cols if col not in df.columns]
        if missing_cols:
            raise ValueError(f"{name} is missing columns: {missing_cols}")
        if df[ID_COL].duplicated().any():
            raise ValueError(f"{name} contains duplicate PATIENT_ID values.")
        if set(df[ID_COL]) != expected_ids:
            raise ValueError(f"{name} does not contain exactly the same patient IDs as age_df.")

    # Validate treatment coding.
    treatments = dataframes["treatment_df"][QUARTER_COLS].to_numpy()
    finite_treatments = treatments[pd.notna(treatments)]
    invalid_treatments = np.setdiff1d(np.unique(finite_treatments), np.arange(N_TREATMENTS))
    if len(invalid_treatments):
        raise ValueError(
            f"treatment_df contains values outside 0..{N_TREATMENTS - 1}: "
            f"{invalid_treatments.tolist()}"
        )

    # relapse_df should already be cumulative and therefore non-decreasing.
    relapse = dataframes["relapse_df"][QUARTER_COLS].apply(pd.to_numeric, errors="coerce")
    relapse_diff = relapse.diff(axis=1).iloc[:, 1:]
    if (relapse_diff < 0).any().any():
        raise ValueError(
            "relapse_df is not non-decreasing across quarters. This pipeline expects "
            "cumulative relapse counts, not quarterly relapse indicators."
        )


def split_patient_ids(
    patient_ids,
    train_fraction=0.60,
    val_fraction=0.20,
    test_fraction=0.20,
    random_state=42,
):
    """
    Randomly split patient IDs into train / validation / test sets.

    Default:
        60% train
        20% validation
        20% test
    """

    if not np.isclose(
        train_fraction + val_fraction + test_fraction,
        1.0
    ):
        raise ValueError(
            "train_fraction + val_fraction + test_fraction must equal 1."
        )

    patient_ids = np.asarray(patient_ids)

    rng = np.random.default_rng(random_state)

    shuffled_ids = patient_ids.copy()
    rng.shuffle(shuffled_ids)

    n = len(shuffled_ids)

    n_train = int(round(n * train_fraction))
    n_val = int(round(n * val_fraction))

    train_ids = shuffled_ids[:n_train]

    val_ids = shuffled_ids[
        n_train:n_train + n_val
    ]

    test_ids = shuffled_ids[
        n_train + n_val:
    ]

    return train_ids, val_ids, test_ids


def _prepare_sparse_history(
    df: pd.DataFrame,
    ids: Iterable,
    fill_value: float,
) -> Tuple[np.ndarray, np.ndarray]:
    """Forward-fill sparse measurements within Q1-Q20 and retain an observation mask."""
    raw = _quarter_values(df, ids, dtype=np.float32)[:, :HISTORY_LENGTH]
    observed = (~np.isnan(raw)).astype(np.float32)
    filled = pd.DataFrame(raw).ffill(axis=1).to_numpy(dtype=np.float32)
    filled = np.where(np.isnan(filled), fill_value, filled)
    return filled, observed


def fit_preprocessing_params(
    dataframes: Mapping[str, pd.DataFrame],
    train_ids: Iterable,
) -> PreprocessingParams:
    """Fit imputation and standardisation parameters using training Q1-Q20 only."""
    train_ids = list(train_ids)

    edss_train = _quarter_values(dataframes["disability_df"], train_ids)[:, :HISTORY_LENGTH]
    mri_train = _quarter_values(dataframes["t2_mri_lesion_df"], train_ids)[:, :HISTORY_LENGTH]

    edss_fill = float(np.nanmedian(edss_train))
    mri_fill = float(np.nanmedian(mri_train))

    # Build an unscaled training feature tensor first.
    features = _build_history_features(
        dataframes=dataframes,
        ids=train_ids,
        edss_fill_value=edss_fill,
        mri_fill_value=mri_fill,
    )

    means = np.zeros(len(FEATURE_NAMES), dtype=np.float32)
    stds = np.ones(len(FEATURE_NAMES), dtype=np.float32)

    for idx in CONTINUOUS_FEATURE_INDICES:
        values = features[:, :, idx]
        means[idx] = np.mean(values)
        std = np.std(values)
        stds[idx] = std if std > 1e-8 else 1.0

    return PreprocessingParams(
        edss_fill_value=edss_fill,
        mri_fill_value=mri_fill,
        feature_means=means,
        feature_stds=stds,
        continuous_feature_indices=CONTINUOUS_FEATURE_INDICES,
    )


def _build_history_features(
    dataframes: Mapping[str, pd.DataFrame],
    ids: Iterable,
    edss_fill_value: float,
    mri_fill_value: float,
) -> np.ndarray:
    ids = list(ids)

    edss, edss_observed = _prepare_sparse_history(
        dataframes["disability_df"], ids, edss_fill_value
    )
    mri, mri_observed = _prepare_sparse_history(
        dataframes["t2_mri_lesion_df"], ids, mri_fill_value
    )
    

    relapse = _quarter_values(dataframes["relapse_df"], ids)[:, :HISTORY_LENGTH]
    age = _quarter_values(dataframes["age_df"], ids)[:, :HISTORY_LENGTH]
    disease_duration = _quarter_values(dataframes["disease_duration_df"], ids)[:, :HISTORY_LENGTH]
    gender = _quarter_values(dataframes["gender_df"], ids)[:, :HISTORY_LENGTH]
    cumulative_visits = _quarter_values(dataframes["cumulative_visits_df"], ids)[:, :HISTORY_LENGTH]
    active_entry = _quarter_values(dataframes["active_entries_df"], ids, dtype=np.float32)[:, :HISTORY_LENGTH]

    # These should be fully observed for model input. If a source table contains a rare NA,
    # fail visibly rather than silently leaking an arbitrary value into the model.
    dense = {
        "relapse": relapse,
        "age": age,
        "disease_duration": disease_duration,
        "gender": gender,
        "cumulative_visits": cumulative_visits,
        "active_entry": active_entry,
    }
    for name, arr in dense.items():
        if np.isnan(arr).any():
            raise ValueError(f"{name} contains missing values within Q1-Q20.")

    return np.stack(
        [
            edss,
            relapse,
            mri,
            age,
            disease_duration,
            gender,
            cumulative_visits,
            edss_observed,
            mri_observed,
            active_entry,
        ],
        axis=-1,
    ).astype(np.float32)


def build_ms_dataset(
    dataframes: Mapping[str, pd.DataFrame],
    ids: Iterable,
    params: PreprocessingParams,
) -> Dict[str, np.ndarray]:
    """Build one fixed-window dataset for the Q1-Q20 -> Q21-Q40 experiment."""
    ids = np.asarray(list(ids))

    history_covariates = _build_history_features(
        dataframes=dataframes,
        ids=ids,
        edss_fill_value=params.edss_fill_value,
        mri_fill_value=params.mri_fill_value,
    )

    for idx in params.continuous_feature_indices:
        history_covariates[:, :, idx] = (
            history_covariates[:, :, idx] - params.feature_means[idx]
        ) / params.feature_stds[idx]

    treatment = _quarter_values(dataframes["treatment_df"], ids, dtype=np.float32)
    if np.isnan(treatment[:, :40]).any():
        raise ValueError("treatment_df contains missing treatment values within Q1-Q40.")
    treatment = treatment.astype(np.int64)
    treatment_one_hot = np.eye(N_TREATMENTS, dtype=np.float32)[treatment]

    history_treatments = treatment_one_hot[:, :HISTORY_LENGTH, :]

    # Decoder path contains the Q20 boundary followed by Q21-Q40.
    # This gives 21 control points and therefore 20 future intervals.
    future_treatments = treatment_one_hot[:, HISTORY_LENGTH - 1 : HISTORY_LENGTH + FORECAST_LENGTH, :]

    cumulative_relapse = _quarter_values(dataframes["relapse_df"], ids, dtype=np.float32)
    baseline_relapse = cumulative_relapse[:, HISTORY_LENGTH - 1]
    future_cumulative = cumulative_relapse[:, HISTORY_LENGTH : HISTORY_LENGTH + FORECAST_LENGTH]
    
    future_increments = np.diff(np.concatenate([baseline_relapse[:, None], future_cumulative], axis=1), axis=1,).astype(np.float32)

    if (future_increments < 0).any():
        raise ValueError("Derived relapse increments contain negative values.")

    active_entries = _quarter_values(dataframes["active_entries_df"], ids, dtype=np.float32)
    history_active = active_entries[:, :HISTORY_LENGTH]
    future_active = active_entries[:, HISTORY_LENGTH:HISTORY_LENGTH + FORECAST_LENGTH]

    history_time_1d = np.linspace(0.0, 1.0, HISTORY_LENGTH, dtype=np.float32)
    history_time = np.broadcast_to(
        history_time_1d[None, :, None],
        (len(ids), HISTORY_LENGTH, 1),
    ).copy()

    future_time_1d = np.linspace(0.0, 1.0, FORECAST_LENGTH + 1, dtype=np.float32)
    future_time = np.broadcast_to(
        future_time_1d[None, :, None],
        (len(ids), FORECAST_LENGTH + 1, 1),
    ).copy()

    return {
        "patient_ids": ids,
        "history_covariates": history_covariates.astype(np.float32),
        "history_treatments": history_treatments.astype(np.float32),
        "history_time": history_time.astype(np.float32),
        "future_treatments": future_treatments.astype(np.float32),
        "future_time": future_time.astype(np.float32),
        "baseline_relapse": baseline_relapse.astype(np.float32),
        "future_cumulative_relapse": future_cumulative.astype(np.float32),
        "future_relapse_increments": future_increments.astype(np.float32),
        "history_active": history_active.astype(np.float32),
        "future_active": future_active.astype(np.float32),
    }


def build_train_val_test(
    dataframes: Mapping[str, pd.DataFrame],
    random_state: int = 42,
) -> Tuple[Dict[str, np.ndarray], Dict[str, np.ndarray], Dict[str, np.ndarray], PreprocessingParams]:
    """Validate, split patients, fit training preprocessing, and build all three datasets."""
    validate_dataframes(dataframes)

    patient_ids = dataframes["age_df"][ID_COL].to_numpy()
    train_ids, val_ids, test_ids = split_patient_ids(
    patient_ids,
    train_fraction=0.60,
    val_fraction=0.20,
    test_fraction=0.20,
    random_state=random_state,
)

    params = fit_preprocessing_params(dataframes, train_ids)

    training_data = build_ms_dataset(dataframes, train_ids, params)
    validation_data = build_ms_dataset(dataframes, val_ids, params)
    test_data = build_ms_dataset(dataframes, test_ids, params)

    return training_data, validation_data, test_data, params


def describe_dataset(name: str, data: Mapping[str, np.ndarray]) -> None:
    print(f"\n{name}")
    for key, value in data.items():
        if hasattr(value, "shape"):
            print(f"  {key:30s} {value.shape}")


def process_data(pickle_map):
    """Compatibility helper if main code stores datasets in a pickle_map."""
    return (
        pickle_map["training_data"],
        pickle_map["validation_data"],
        pickle_map["test_data"],
    )
