output_data_treatments = []

for _, row in patients_follow_up.iterrows():
    patient_id = row['PATIENT_ID']
    
    # Generate quarterly date range
    quarterly_range = pd.date_range(start=row['START_FOLLOW_UP'], end=row['END_FOLLOW_UP'], freq='3MS')
    
    # Initialize treatment efficacy for each quarter with 0 (no treatment)
    quarterly_treatment = [0] * len(quarterly_range)
    
    # Get treatments for the current patient
    patient_treatments = patients_treatments[patients_treatments['PATIENT_ID'] == patient_id]
    
    for i, start_date in enumerate(quarterly_range):
        end_date = start_date + pd.DateOffset(months=3) - pd.Timedelta(days=1)  # End of quarter
        
        # Filter treatments active in this quarter
        active_treatments = patient_treatments[(patient_treatments['START_DATE.y'] <= end_date) & 
                                               (patient_treatments['END_DATE'] >= start_date)]
        
        if not active_treatments.empty:
            # Calculate how long each treatment was active in the quarter
            active_treatments['DAYS_ON_TREATMENT'] = active_treatments.apply(
                lambda x: (min(x['END_DATE'], end_date) - max(x['START_DATE.y'], start_date)).days + 1, axis=1
            )

            # Select the treatment with the longest duration in this quarter
            longest_treatment = active_treatments.loc[active_treatments['DAYS_ON_TREATMENT'].idxmax()]
            quarterly_treatment[i] = longest_treatment['EFFICACY']
    
    # Store patient data
    output_data_treatments.append([patient_id] + quarterly_treatment)

# Determine max number of quarters across patients
max_quarters = max(len(data) - 1 for data in output_data_treatments)  # Exclude PATIENT_ID

# Create column names for the DataFrame
column_names = [f"Quarter_{i+1}" for i in range(max_quarters)]

