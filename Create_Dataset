# Create the output DataFrame

output_data_relapses = []

for _, row in patients_follow_up.iterrows():
    patient_id = row['PATIENT_ID']
    
    # Generate date range with a frequency of 3 months
    quarterly_range = pd.date_range(start=row['START_FOLLOW_UP'], end=row['END_FOLLOW_UP'], freq='3MS')
    
    # Get the patient's relapse dates
    patient_relapses = patients_relapses[patients_relapses['PATIENT_ID'] == patient_id]['DATE_OF_ONSET']
    
    # Track relapses per quarter
    quarterly_relapse = []
    
    for start_date in quarterly_range:
        end_date = start_date + pd.DateOffset(months=3) - pd.Timedelta(days=1)  # End of quarter
        
        # Check if any relapse falls within this quarter
        has_relapse = patient_relapses.between(start_date, end_date).any()
        
        # Assign 1 if relapse occurred, otherwise 0
        quarterly_relapse.append(1 if has_relapse else 0)
    
    output_data_relapses.append({'PATIENT_ID': patient_id, 'RELAPSES': quarterly_relapse})

